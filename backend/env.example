# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Production (Render): add your *.onrender.com host or rely on RENDER_EXTERNAL_HOSTNAME
# ALLOWED_HOSTS=127.0.0.1,localhost,your-service.onrender.com

# GitHub personal access token (repo scope)
GITHUB_TOKEN=

# OpenAI (sprint summary chat)
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# Supabase PostgreSQL (required) — session pooler URI, port 5432
DATABASE_URL=postgresql://postgres.PROJECT_REF:your-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Production CORS — Vercel app URL (or comma-separated list)
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
